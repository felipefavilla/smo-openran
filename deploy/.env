################################################################################
# SMO Open RAN - Parte 2
# Especializacao Open RAN / CPQD - Gestao, Orquestracao e Automacao em Redes OpenRAN
#
# Todas as imagens abaixo sao artefatos oficiais publicados pela O-RAN Software
# Community (nexus3.o-ran-sc.org) e pelo ONAP (nexus3.onap.org), nas versoes
# fixadas pela M-Release do projeto OAM.
################################################################################

COMPOSE_PROJECT_NAME=smo-openran

# ------------------------------------------------------------------ credenciais
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

NETCONF_USERNAME=netconf
NETCONF_PASSWORD=netconf!

VES_ENDPOINT_USERNAME=sample1
VES_ENDPOINT_PASSWORD=sample1

# ------------------------------------------------------- imagens oficiais O-RAN SC
# SDN Controller (SDN-R / OpenDaylight) - cliente NETCONF da interface O1
SDNC_IMAGE=nexus3.o-ran-sc.org:10001/o-ran-sc/oam-oam-controller/sdnr-image:13.0.1
# ODLUX - interface web oficial do controlador
SDNC_WEB_IMAGE=nexus3.o-ran-sc.org:10001/o-ran-sc/oam-oam-controller/sdnr-web-image:13.0.1
# Simuladores de funcoes de rede O-RAN (projeto sim-o1-interface)
NTS_O_DU_IMAGE=nexus3.o-ran-sc.org:10004/o-ran-sc/nts-ng-o-ran-du:1.8.1
NTS_O_RU_IMAGE=nexus3.o-ran-sc.org:10004/o-ran-sc/nts-ng-o-ran-ru-fh:1.8.1
# Non-RT RIC - interface A1
A1_PMS_IMAGE=nexus3.o-ran-sc.org:10002/o-ran-sc/nonrtric-a1-policy-management-service:2.3.1
A1_SIM_IMAGE=nexus3.o-ran-sc.org:10002/o-ran-sc/a1-simulator:2.2.0

# ------------------------------------------------------------ imagens oficiais ONAP
# VES Collector - ingestao de eventos da interface O1
VES_COLLECTOR_IMAGE=nexus3.onap.org:10001/onap/org.onap.dcaegen2.collectors.ves.vescollector:1.12.5

# --------------------------------------------------- infraestrutura (versoes OSC)
PERSISTENCE_IMAGE=mariadb:11.1.2
KAFKA_IMAGE=quay.io/strimzi/kafka:0.35.0-kafka-3.4.0

# ------------------------------------------------------------------------- portas
# Portal SMO (interface principal do operador)
PORTAL_PORT=8080
# ODLUX (interface oficial do controlador)
ODLUX_PORT=8181
# RESTCONF do SDN-R
SDNC_REST_PORT=8282
# VES Collector (endpoint de eventos)
VES_PORT=8383
# A1 Policy Management Service
A1_PMS_PORT=8484
# Near-RT RIC (simulador A1)
A1_SIM_PORT=8585
# NETCONF Call Home (SSH)
CALLHOME_PORT=4334

# ---------------------------------------------------------------- limites de JVM
# O compose oficial usa -Xmx4g. Reduzido para caber em Docker Desktop com 6-8 GB.
SDNC_JAVA_OPTS=-Xms256m -Xmx1200m
